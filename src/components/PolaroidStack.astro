---
import Polaroid from "./Polaroid.astro";

interface Photo {
	src?: string;
	alt?: string;
	placeholder?: string;
}

interface Props {
	photos: Photo[];
}

const { photos } = Astro.props;
const rotations = [-6, 4, -3, 5];
const offsets = [
	{ top: "1.5rem", left: "1.5rem" },
	{ top: "0.7rem", left: "0.7rem" },
	{ top: "0", left: "0" },
];
---

<div class="polaroid-stack">
	{
		photos.map((photo, i) => (
			<div style={`position: absolute; top: ${offsets[i]?.top ?? "0"}; left: ${offsets[i]?.left ?? "0"}; z-index: ${photos.length - i};`}>
				<Polaroid src={photo.src} alt={photo.alt} placeholder={photo.placeholder} rotate={rotations[i % rotations.length]} />
			</div>
		))
	}
</div>
