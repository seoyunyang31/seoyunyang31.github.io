---
import PlainPhoto from "./PlainPhoto.astro";

interface Photo {
	src?: string;
	alt?: string;
	placeholder?: string;
}

interface Props {
	photos: Photo[];
	title: string;
	subtitle: string;
	duration: string;
	description: string;
}

const { photos, title, subtitle, duration, description } = Astro.props;
---

<article class="gallery-card">
	<div class={`gallery-card-photos ${photos.length > 1 ? "multi" : ""}`}>
		{photos.map((photo) => <PlainPhoto src={photo.src} alt={photo.alt} placeholder={photo.placeholder} />)}
	</div>
	<div class="gallery-card-text">
		<p class="title">{title}</p>
		<p class="subtitle">{subtitle}</p>
		<p class="duration">{duration}</p>
		<p class="description">{description}</p>
	</div>
</article>
