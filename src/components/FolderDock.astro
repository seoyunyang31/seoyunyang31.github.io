---
const folders = [
	{ href: "/", label: "About Myself" },
	{ href: "/experience/", label: "Professional Experience" },
	{ href: "/extracurriculars/", label: "Extracurriculars" },
	{ href: "/projects/", label: "Projects" },
];

const currentPath = Astro.url.pathname;
---

<nav class="folder-dock" aria-label="Sections">
	{
		folders.map((folder) => (
			<a class={`folder-item ${currentPath === folder.href ? "active" : ""}`} href={folder.href} aria-current={currentPath === folder.href ? "page" : undefined}>
				<svg class="folder-icon" viewBox="0 0 64 52" aria-hidden="true">
					<path d="M2 10a4 4 0 0 1 4-4h14l6 6h32a4 4 0 0 1 4 4v2H2z" fill="#FFCF4D" />
					<rect x="2" y="14" width="60" height="34" rx="5" fill="#FDBB2D" />
				</svg>
				<span class="folder-label">{folder.label}</span>
			</a>
		))
	}
</nav>
