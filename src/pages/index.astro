---
import Layout from "../layouts/Layout.astro";
import Polaroid from "../components/Polaroid.astro";
---

<Layout title="Seoyun Yang">
	<main>
		<header>
			<h1>Hi! I'm Seoyun</h1>
			<h1>Welcome to my website :)</h1>
		</header>

		<section class="row">
			<Polaroid placeholder="polaroid like image of myself" rotate={-4} />
			<div class="text">intro bout myself</div>
		</section>

		<section class="row reverse">
			<Polaroid placeholder="image about school" rotate={5} />
			<div class="details">
				<p>Degree</p>
				<p>School</p>
				<p>Major</p>
				<p>Period</p>
			</div>
		</section>
	</main>
</Layout>
