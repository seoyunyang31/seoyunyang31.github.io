---
import Layout from "../layouts/Layout.astro";
import FileCard from "../components/FileCard.astro";
---

<Layout title="Seoyun Yang">
	<main>
		<FileCard filename="ABOUT_MYSELF.PNG" photoPlaceholder="photo of myself" photoAspect="3 / 4">
			<p class="intro-heading"><span class="field-label">Name:</span> Seoyun Yang</p>
			<p>
				<span class="field-label description-label">Description:</span>
				Hi! My name is Seoyun, Thank you for visiting my website! blahblahblah
			</p>
		</FileCard>

		<FileCard filename="EDUCATION_BACHELORS.PNG" photoPlaceholder="university of toronto crest" photoAspect="1 / 1" reverse>
			<p><span class="field-label">Institution:</span> University of Toronto</p>
			<p><span class="field-label">Degree:</span> Applied Science and Engineering</p>
			<p><span class="field-label">Major:</span> Engineering Science / Machine Intelligence</p>
			<p><span class="field-label">Minor:</span> Robotics and Mechatronics</p>
			<p><span class="field-label">Duration:</span> 2022 – 2026</p>
		</FileCard>
	</main>
</Layout>
