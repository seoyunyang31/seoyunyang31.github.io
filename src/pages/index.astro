---
import Layout from "../layouts/Layout.astro";
import Polaroid from "../components/Polaroid.astro";
import PlainPhoto from "../components/PlainPhoto.astro";

const teasers = [
	{ href: "/experience/", label: "Experience", placeholder: "experience" },
	{ href: "/projects/", label: "Projects", placeholder: "projects" },
	{ href: "/extracurriculars/", label: "Extracurriculars", placeholder: "extracurriculars" },
];
---

<Layout title="Seoyun Yang">
	<main>
		<header>
			<h1>Hi! I'm Seoyun</h1>
			<h1>Welcome to my website :)</h1>
		</header>

		<section class="row">
			<Polaroid placeholder="polaroid like image of myself" rotate={-4} />
			<div class="text">Write a short, warm 2–4 sentence bio here.</div>
		</section>

		<section class="row reverse">
			<PlainPhoto placeholder="image about school" />
			<div class="details">
				<p>Degree</p>
				<p>School</p>
				<p>Major</p>
				<p>Period</p>
			</div>
		</section>

		<p class="section-label">More about me</p>
		<div class="teaser-grid">
			{
				teasers.map((teaser) => (
					<a class="teaser-card" href={teaser.href}>
						<PlainPhoto placeholder={teaser.placeholder} />
						<p class="label">{teaser.label}</p>
					</a>
				))
			}
		</div>
	</main>
</Layout>
